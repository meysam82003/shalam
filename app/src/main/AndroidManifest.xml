<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Only for the optional Pro subscription, plans and ads; every game works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for recording the narrator's own voice for a mafia cue; asked when the narrator taps «ضبط». -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Notifications: subscription reminders, and offers only for players who said yes (Android 13+ asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the few-times-a-day notification check scheduled after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Divan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Back to the app» after a web payment: only opens the app and asks the server; never proof of payment. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="divan" android:host="pay" />
            </intent-filter>
        </activity>
        <service
            android:name=".NoticeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Store and server of this build (filled by the bazaar / myket flavor). -->
        <meta-data android:name="divan.store" android:value="${divanStore}" />
        <meta-data android:name="divan.api" android:value="${divanApi}" />
        <meta-data android:name="divan.licenseKey" android:value="${divanLicenseKey}" />
        <meta-data android:name="divan.myketKey" android:value="${divanMyketKey}" />
        <meta-data android:name="divan.bazaarKey" android:value="${divanBazaarKey}" />
        <meta-data android:name="divan.certSha256" android:value="${divanCertSha256}" />
        <meta-data android:name="divan.tapsellAppId" android:value="${divanTapsell}" />
        <!-- The ad network must never start by itself: it is started in code, only for free users. -->
        <provider
            android:name="ir.tapsell.mediation.core.internal.init.Initializer"
            android:authorities="${applicationId}.tapsell-init"
            tools:node="remove" />
        <provider
            android:name=".ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
