<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="divan_pro.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="divan_pro.xml" />
    </device-transfer>
</data-extraction-rules>
